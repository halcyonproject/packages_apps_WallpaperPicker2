package: "com.android.wallpaper"
container: "system_ext"

flag {
    name: "wallpaper_restorer_flag"
    namespace: "customization_picker"
    description: "Enables wallpaper restorer when the flag is turned on."
    bug: "285047815"
}

flag {
    name: "enable_pack_theme_entry"
    namespace: "customization_picker"
    description: "Enable the entry of the theme."
    bug: "372344184"
}

flag {
    name: "new_creative_wallpaper_category"
    namespace: "customization_picker"
    description: "Add new column for the new creative wallpaper."
    bug: "381009822"
}

flag {
    name: "creative_wallpaper_field_collection_wallpaper"
    namespace: "customization_picker"
    description: "Add new field IsCollectionWallpaper for the new creative wallpaper."
    bug: "381009822"
}

flag {
   name: "compose_refactor_flag"
   namespace: "customization_picker"
   description: "Refactor pieces of picker UI into compose."
   bug: "391918848"
}

flag {
   name: "color_picker_update_flag"
   namespace: "customization_picker"
   description: "Update color picker with new UI and functionality, and integrate with ThemeService"
   bug: "391927276"
}

flag {
    name: "fullscreen_preview_flag"
    namespace: "customization_picker"
    description: "Enables full screen wallpaper preview"
    bug: "409100074"
}

flag {
    name: "fullscreen_preview_flow_fix"
    namespace: "customization_picker"
    description: "Changes the flow of wallpaper preview fullscreen"
    bug: "442337477"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "adaptive_wallpaper_flag"
    namespace: "customization_picker"
    description: "Add wallpapers that change based on the system's theme"
    bug: "350781760"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

flag {
    name: "refactor_individual_picker_flag"
    namespace: "customization_picker"
    description: "Migrates the individual picker screen to use the recommended architecture, Compose WallpaperModel and CategoryModel "
    bug: "433284926"
}

flag {
    name: "refactor_wallpaper_preview_screen_flag"
    namespace: "customization_picker"
    description: "Refactor the wallpaper preview screen into Compose."
    bug: "423956081"
}

flag {
    name: "refactor_wallpaper_info_flag"
    namespace: "customization_picker"
    description: "Flag for enabling the photo shuffle feature in the wallpaper picker app"
    bug: "448461866"
}

flag {
    name: "collapsable_reordered_ai_wallpapers_screen"
    namespace: "customization_picker"
    description: "Flag for enabling the new AI wallpapers layout with collapsable sections and reordered templates"
    bug: "457835470"
}

flag {
    name: "enable_recent_wallpaper_deletion"
    namespace: "customization_picker"
    description: "Enables deletion of recent wallpaper entries for creative wallpapers when their assets are deleted"
    bug: "464098463"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "enable_recents_deletion_via_provider"
    namespace: "customization_picker"
    description: "Enables deletion of recent wallpaper entries via the content provider"
    bug: "465589212"
}

flag {
    name: "enable_android_photopicker"
    namespace: "customization_picker"
    description: "Enables the Android Photopicker"
    bug: "475397703"
}

flag {
    name: "enable_ai_clocks"
    namespace: "customization_picker"
    description: "Enables AI clocks functionality"
    bug: "479587332"
    metadata {
            purpose: PURPOSE_FEATURE
    }
}


flag {
    name: "enable_effect_for_cat_smile"
    namespace: "customization_picker"
    description: "Enables effect for the cat smile project"
    bug: "479401365"
}
